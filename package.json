{
  "name": "zentra-agent-team",
  "productName": "Zentra Agent Team",
  "version": "0.3.1",
  "description": "Build projects by chatting with your agent team. Claude, OpenAI, Gemini, Ollama and more on one desktop.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Zentra Engine",
    "email": "info@zentraengine.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "checksum": "node scripts/checksum.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.zentraengine.agentteam",
    "productName": "Zentra Agent Team",
    "copyright": "Copyright © 2026 Zentra Engine",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/**"
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Zentra-Agent-Team-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zentra Agent Team",
      "uninstallDisplayName": "Zentra Agent Team",
      "deleteAppDataOnUninstall": false,
      "language": "1055",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@45.1.0": true
  },
  "homepage": "https://zentraengine.com"
}
